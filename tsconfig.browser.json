{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["chrome"],
    "rootDir": "browser-runtime",
    "outDir": "dist/browser-probe",
    "skipLibCheck": true
  },
  "include": ["browser-runtime/**/*.ts"]
}
