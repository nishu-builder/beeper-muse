{
  "name": "beeper-muse",
  "version": "0.1.0",
  "description": "Direct local connector between Beeper and the Muse web app, without WhatsApp.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run build && npm run format:check",
    "prebuild": "node -e \"require(\\\"node:fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\""
  },
  "dependencies": {
    "@beeper/desktop-api": "5.0.0",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
