{
  "name": "beeper-muse",
  "version": "0.4.0",
  "description": "Custom Beeper bridge for a dedicated Muse chat, connected directly through your browser.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "go build -tags goolm -o bin/beeper-muse ./cmd/beeper-muse",
    "start": "node scripts/manage.mjs",
    "test": "tsx --test test/*.test.ts && go test -tags goolm ./...",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . && gofmt -w cmd internal",
    "format:check": "prettier --check . && node scripts/check-go-format.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
