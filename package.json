{
  "name": "beeper-muse",
  "version": "0.8.16",
  "description": "Your Muse conversation in Beeper, connected directly from Chrome.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:browser-runtime",
    "update:local": "npm run build && node scripts/prepare-browser-runtime.mjs",
    "store:check": "node scripts/check-store.mjs",
    "start": "node scripts/manage.mjs",
    "test": "npm run build:browser-runtime && tsx --test test/*.test.ts && go test -tags goolm ./...",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "format": "prettier --write . && gofmt -w cmd internal",
    "format:check": "prettier --check . && node scripts/check-go-format.mjs",
    "check": "npm run typecheck && npm test && npm run build:native && npm run format:check",
    "package": "npm run build:browser-runtime && node scripts/package.mjs",
    "build:extension": "tsc -p tsconfig.extension.json && prettier --write extension/adapter.js extension/sync.js extension/bridge.js extension/activity.js",
    "build:native": "go build -tags goolm -o bin/beeper-muse ./cmd/beeper-muse",
    "build:browser-probe": "tsc -p tsconfig.browser.json && node scripts/build-browser-probe.mjs",
    "setup:browser-probe": "npm run build:browser-probe && node scripts/setup-browser-probe.mjs",
    "build:browser-runtime": "npm run build:extension && node scripts/build-browser-runtime.mjs",
    "prepare:browser-runtime": "npm run build:browser-runtime && node scripts/prepare-browser-runtime.mjs",
    "build:legacy": "npm run build:extension && npm run build:native",
    "prepare:registration": "node scripts/registration.mjs",
    "dev:doctor": "tsx scripts/dev/cli.ts doctor",
    "dev:test": "tsx scripts/dev/cli.ts run",
    "dev:observe": "tsx scripts/dev/cli.ts observe",
    "dev:close": "tsx scripts/dev/cli.ts close",
    "dev:cycle": "tsx scripts/dev/cycle.ts"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.8.0",
    "parse5": "8.0.1",
    "yaml": "2.9.1"
  }
}
