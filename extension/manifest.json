{
  "manifest_version": 3,
  "name": "Beeper Muse",
  "description": "Connect your dedicated Muse chat in Beeper to your signed-in Muse browser tab.",
  "version": "0.2.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:24819/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://muse.ai/*"],
      "js": ["adapter.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
